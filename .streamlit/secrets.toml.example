# ╔═══════════════════════════════════════════════════════════════╗
# ║         STREAMLIT CLOUD SECRETS CONFIGURATION                 ║
# ║  How to deploy emotion detection on Streamlit Cloud:          ║
# ╚═══════════════════════════════════════════════════════════════╝
#
# STEP 1: Go to Streamlit Cloud Dashboard
#   → https://share.streamlit.io/
#   → Select your 'Music-Therapy' app
#
# STEP 2: Access App Settings
#   → Click the THREE DOTS (...) in top right → Settings
#   → OR click the Settings gear icon (⚙️)
#
# STEP 3: Add Secrets
#   → Click "Secrets" in left sidebar
#   → Copy the TOML section below into the text editor
#   → Replace YOUR_*_HERE with your actual API keys
#   → Click "Save"
#
# STEP 4: App Auto-Restarts
#   → Streamlit will automatically redeploy your app
#   → Emotion detection should now work! ✓

# ═════════════════════════════════════════════════════════════════
# REQUIRED: Face++ API Credentials (for emotion detection)
# ═════════════════════════════════════════════════════════════════

FACEPP_API_KEY = "YOUR_FACEPP_API_KEY_HERE"
FACEPP_API_SECRET = "YOUR_FACEPP_API_SECRET_HERE"

# ═════════════════════════════════════════════════════════════════
# OPTIONAL: Hume API (alternative emotion detection method)
# ═════════════════════════════════════════════════════════════════

# HUME_API_KEY = "YOUR_HUME_API_KEY_HERE"
# USE_HUME = "0"
